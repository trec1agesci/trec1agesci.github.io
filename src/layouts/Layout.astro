---
import { Font } from 'astro:assets';
import Sidebar from '../components/Sidebar.astro';
import {
	DEFAULT_OG_IMAGE,
	FOOTER_LINKS,
	HEADER_LOGO_PATH,
	SITE_DESCRIPTION,
	SITE_TITLE,
	SOCIAL_LINKS,
	TOP_LINKS,
	type NavLink,
} from '../consts';

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	published?: Date;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	noindex?: boolean;
	plain?: boolean;
}

const {
	title,
	description = SITE_DESCRIPTION,
	image = DEFAULT_OG_IMAGE,
	type = 'website',
	published,
	jsonLd,
	noindex = false,
	plain = false,
} = Astro.props;

const hideFromSearch = noindex || import.meta.env.SITE_ENV !== 'production';
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = Astro.url.pathname === '/' ? SITE_TITLE : `${title} – ${SITE_TITLE}`;
const imageUrl = new URL(image, Astro.site);
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
const path = Astro.url.pathname;
const isActive = (l: NavLink) =>
	!l.external && (l.href === '/' ? path === '/' : path.startsWith(l.href));
const external = (l: NavLink) =>
	l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<!doctype html>
<html lang="it">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		{hideFromSearch && <meta name="robots" content="noindex" />}
		{!noindex && <link rel="canonical" href={canonical} />}
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/feed/" />
		<Font cssVariable="--font-montserrat" preload />
		<meta property="og:site_name" content={SITE_TITLE} />
		<meta property="og:locale" content="it_IT" />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageUrl} />
		{published && <meta property="article:published_time" content={published.toISOString()} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		{jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}
	</head>
	<body>
		<header class="site-header">
			<div class="wrap bar">
				<a class="brand" href="/">
					<img src={HEADER_LOGO_PATH} alt={SITE_TITLE} width="110" height="110" />
				</a>
				<button
					class="menu-toggle"
					type="button"
					aria-expanded="false"
					aria-controls="sidebar"
				>
					Menu
				</button>
				<nav class="top-nav" aria-label="Principale">
					{
						TOP_LINKS.map((l) => (
							<a href={l.href} aria-current={isActive(l) ? 'page' : undefined} {...external(l)}>
								{l.label}
							</a>
						))
					}
				</nav>
			</div>
		</header>
		<div class="wrap layout">
			<aside id="sidebar" class="sidebar">
				<Sidebar />
			</aside>
			<main class:list={[plain ? 'plain' : 'card']}>
				<slot />
			</main>
		</div>
		<footer class="site-footer">
			<div class="wrap">
				<nav class="foot-nav" aria-label="Collegamenti del sito">
					{
						TOP_LINKS.map((l) => (
							<a href={l.href} {...external(l)}>
								{l.label}
							</a>
						))
					}
				</nav>
				<nav class="foot-nav" aria-label="Social">
					{
						SOCIAL_LINKS.map((l) => (
							<a href={l.href} {...external(l)}>
								{l.label}
							</a>
						))
					}
				</nav>
				<nav class="foot-nav legal" aria-label="Informazioni legali">
					{FOOTER_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
				</nav>
			</div>
		</footer>
		<script is:inline>
			const toggle = document.querySelector('.menu-toggle');
			const sidebar = document.getElementById('sidebar');
			toggle?.addEventListener('click', () => {
				const open = sidebar.classList.toggle('open');
				toggle.setAttribute('aria-expanded', String(open));
			});
		</script>
	</body>
</html>

<style is:global>
	:root {
		--primary: #6528f7;
		--primary-hover: #5511f8;
		--deep: #5500a9;
		--lavender: #f2f0fe;
		--lavender-line: #d8d8f5;
		--ink: #0f172a;
		--text: #212529;
		--muted: #454f5e;
	}
	* {
		box-sizing: border-box;
	}
	body {
		margin: 0;
		font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
		font-size: 17px;
		line-height: 1.7;
		color: var(--text);
		background: var(--lavender);
		overflow-wrap: break-word;
	}
	h1,
	h2,
	h3,
	h4 {
		font-family: var(--font-montserrat), system-ui, sans-serif;
		font-weight: 600;
		color: var(--ink);
		line-height: 1.3;
	}
	h1 {
		font-size: 2rem;
		margin: 0 0 0.75rem;
	}
	a {
		color: var(--primary);
	}
	a:hover {
		color: var(--primary-hover);
	}
	img,
	video {
		max-width: 100%;
		height: auto;
	}
	iframe {
		max-width: 100%;
		border: 0;
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}
	.wrap {
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1rem;
	}

	/* Header */
	.site-header {
		background: var(--deep);
	}
	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		padding-top: 0.9rem;
		padding-bottom: 0.9rem;
	}
	.brand img {
		display: block;
		width: 110px;
		height: auto;
	}
	.top-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 2rem;
	}
	.top-nav a {
		color: #fefeff;
		text-decoration: none;
		font-size: 1.1rem;
		padding: 0.3rem 0;
		border-bottom: 2px solid transparent;
	}
	.top-nav a:hover,
	.top-nav a[aria-current='page'] {
		color: #fff;
		border-bottom-color: #fff;
	}
	.menu-toggle {
		display: none;
		font: inherit;
		color: #fff;
		background: transparent;
		border: 1px solid #fff;
		border-radius: 4px;
		padding: 0.3rem 1rem;
		cursor: pointer;
	}

	/* Layout a due colonne */
	.layout {
		display: grid;
		grid-template-columns: 300px minmax(0, 1fr);
		gap: 2rem;
		padding-top: 2.5rem;
		padding-bottom: 3rem;
		align-items: start;
	}
	.sidebar .widget {
		background: #fff;
		border-radius: 6px;
		padding: 1.25rem;
		margin-bottom: 1.5rem;
	}
	.sidebar .banner {
		text-align: center;
	}
	.sidebar ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.sidebar li a {
		display: block;
		padding: 0.4rem 0.5rem;
		text-decoration: none;
	}
	.sidebar li a:hover,
	.sidebar li a[aria-current='page'] {
		background: var(--lavender);
		border-radius: 4px;
	}
	.social-card {
		text-align: center;
	}
	.social-title {
		margin: 0 0 0.6rem;
		font-weight: 600;
		color: var(--ink);
	}
	.btn {
		display: inline-block;
		padding: 0.5rem 1.1rem;
		border-radius: 4px;
		background: var(--primary);
		color: #fff;
		font-weight: 600;
		text-decoration: none;
	}
	.btn:hover {
		background: var(--primary-hover);
		color: #fff;
	}
	main.card {
		background: #fff;
		border-radius: 6px;
		padding: 2rem;
	}
	main.plain {
		min-width: 0;
	}
	.meta {
		color: var(--primary);
		font-size: 0.9rem;
		font-weight: 600;
		margin: 0 0 1.5rem;
	}
	.meta a {
		margin-left: 0.6rem;
	}
	.prose p {
		margin: 0 0 1.1em;
	}
	.prose img {
		display: block;
		margin: 1rem 0;
	}

	/* Schede degli articoli */
	.post-card {
		display: grid;
		grid-template-columns: 240px minmax(0, 1fr);
		background: #fff;
		border-radius: 6px;
		overflow: hidden;
		margin-bottom: 1.75rem;
	}
	.post-card .thumb {
		display: block;
		background: var(--deep);
		min-height: 240px;
	}
	.post-card .thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.post-card .body {
		padding: 1.4rem 1.6rem;
	}
	.post-card p {
		margin: 0;
	}
	.card-cats a {
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
		text-transform: lowercase;
		margin-right: 0.6rem;
	}
	.post-card h2 {
		font-size: 1.5rem;
		margin: 0.35rem 0 0.5rem;
	}
	.post-card h2 a {
		color: var(--ink);
		text-decoration: none;
	}
	.post-card h2 a:hover {
		color: var(--primary);
	}
	.post-card .date {
		color: var(--primary);
		font-size: 0.85rem;
		font-weight: 600;
		text-transform: capitalize;
		margin-bottom: 0.6rem;
	}

	/* Paginazione */
	.pagination {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-top: 2rem;
	}
	.pagination .numbers {
		display: flex;
		gap: 0.25rem;
	}
	.pagination a,
	.pagination span {
		min-width: 2.6rem;
		padding: 0.5rem 0.8rem;
		text-align: center;
		text-decoration: none;
		color: var(--ink);
	}
	.pagination [aria-current='page'] {
		background: var(--primary);
		color: #fff;
	}
	.pagination .next {
		color: var(--ink);
		font-size: 1.05rem;
	}

	/* Footer */
	.site-footer {
		background: var(--deep);
		color: #fff;
		padding: 2rem 0;
		text-align: center;
	}
	.foot-nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.4rem 1.5rem;
		margin-bottom: 1rem;
	}
	.site-footer a {
		color: #fff;
		text-decoration: none;
	}
	.site-footer a:hover {
		text-decoration: underline;
	}
	.foot-nav.legal {
		font-size: 0.9rem;
		opacity: 0.85;
		margin-bottom: 0;
	}

	/* Telefono */
	@media (max-width: 860px) {
		.layout {
			grid-template-columns: minmax(0, 1fr);
			padding-top: 1.5rem;
		}
		.js .menu-toggle {
			display: inline-block;
		}
		.js .sidebar {
			display: none;
		}
		.js .sidebar.open {
			display: block;
		}
		.top-nav {
			gap: 0.3rem 1.1rem;
		}
		.post-card {
			grid-template-columns: minmax(0, 1fr);
		}
		.post-card .thumb {
			min-height: 0;
			height: 220px;
		}
		main.card {
			padding: 1.25rem;
		}
	}
</style>
