---
import Pagination from '../components/Pagination.astro';
import PostList from '../components/PostList.astro';
import { LOGO_PATH, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Layout from '../layouts/Layout.astro';
import { getPosts, paginate } from '../lib/posts';

const { items, page, totalPages } = paginate(await getPosts(), 1);

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	url: new URL('/', Astro.site).href,
	logo: new URL(LOGO_PATH, Astro.site).href,
};
---

<Layout title={SITE_TITLE} jsonLd={jsonLd} plain>
	<h1 class="sr-only">{SITE_TITLE}</h1>
	<PostList posts={items} />
	<Pagination base="/" page={page} totalPages={totalPages} />
</Layout>
