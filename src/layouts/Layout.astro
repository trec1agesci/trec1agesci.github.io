---
import {
	DEFAULT_OG_IMAGE,
	FOOTER_LINKS,
	LOGO_PATH,
	NAV_LINKS,
	SITE_DESCRIPTION,
	SITE_TITLE,
} from '../consts';

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	published?: Date;
	jsonLd?: Record<string, unknown>;
}

const {
	title,
	description = SITE_DESCRIPTION,
	image = DEFAULT_OG_IMAGE,
	type = 'website',
	published,
	jsonLd,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = Astro.url.pathname === '/' ? SITE_TITLE : `${title} – ${SITE_TITLE}`;
const imageUrl = new URL(image, Astro.site);
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="it">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/feed/" />
		<meta property="og:site_name" content={SITE_TITLE} />
		<meta property="og:locale" content="it_IT" />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageUrl} />
		{published && <meta property="article:published_time" content={published.toISOString()} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		{jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}
	</head>
	<body>
		<header class="site-header">
			<div class="wrap bar">
				<a class="brand" href="/">
					<img src={LOGO_PATH} alt="" width="44" height="44" />
					<span>{SITE_TITLE}</span>
				</a>
				<nav aria-label="Principale">
					{
						NAV_LINKS.map((l) => (
							<a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
								{l.label}
							</a>
						))
					}
				</nav>
			</div>
		</header>
		<main class="wrap">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="wrap">
				<p>{SITE_TITLE} – {SITE_DESCRIPTION}</p>
				<nav aria-label="Informazioni legali">
					{FOOTER_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
				</nav>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--green: #1f6b3a;
		--green-dark: #144a28;
		--ink: #1d2521;
		--muted: #5b6760;
		--line: #dbe3dd;
		--bg: #f7f9f7;
	}
	* {
		box-sizing: border-box;
	}
	body {
		margin: 0;
		font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
		font-size: 18px;
		line-height: 1.65;
		color: var(--ink);
		background: var(--bg);
		overflow-wrap: break-word;
	}
	a {
		color: var(--green);
	}
	a:hover {
		color: var(--green-dark);
	}
	img,
	iframe,
	video {
		max-width: 100%;
		height: auto;
	}
	iframe {
		border: 0;
	}
	.wrap {
		width: 100%;
		max-width: 820px;
		margin: 0 auto;
		padding: 0 1rem;
	}
	main.wrap {
		padding-top: 2rem;
		padding-bottom: 3rem;
		min-height: 60vh;
	}
	.site-header {
		background: #fff;
		border-bottom: 1px solid var(--line);
	}
	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		padding-top: 0.6rem;
		padding-bottom: 0.6rem;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-weight: 700;
		color: var(--green-dark);
		text-decoration: none;
	}
	.site-header nav,
	.site-footer nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.1rem;
	}
	.site-header nav a {
		padding: 0.3rem 0;
		color: var(--ink);
		text-decoration: none;
		border-bottom: 3px solid transparent;
	}
	.site-header nav a[aria-current='page'],
	.site-header nav a:hover {
		border-bottom-color: var(--green);
	}
	.site-footer {
		background: #fff;
		border-top: 1px solid var(--line);
		padding: 1.5rem 0;
		font-size: 0.9rem;
		color: var(--muted);
	}
	h1,
	h2,
	h3 {
		line-height: 1.25;
	}
	h1 {
		font-size: 2rem;
		margin: 0 0 0.5rem;
	}
	.meta {
		color: var(--muted);
		font-size: 0.9rem;
		margin: 0 0 1.5rem;
	}
	.meta a {
		margin-left: 0.4rem;
	}
	.prose p {
		margin: 0 0 1.1em;
	}
	.prose img {
		display: block;
		margin: 1rem 0;
	}
	.post-card {
		display: flex;
		gap: 1rem;
		padding: 1.1rem 0;
		border-bottom: 1px solid var(--line);
	}
	.post-card img {
		width: 120px;
		height: 120px;
		object-fit: cover;
		border-radius: 6px;
		flex: none;
	}
	.post-card h2 {
		margin: 0 0 0.25rem;
		font-size: 1.25rem;
	}
	.post-card h2 a {
		text-decoration: none;
	}
	.post-card p {
		margin: 0;
	}
	.cats a {
		display: inline-block;
		margin: 0 0.4rem 0.6rem 0;
		padding: 0.1rem 0.7rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: #fff;
		text-decoration: none;
		font-size: 0.9rem;
	}
	.pagination {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 1.5rem;
	}
	.pagination a,
	.pagination span {
		padding: 0.2rem 0.75rem;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: #fff;
		text-decoration: none;
	}
	.pagination [aria-current='page'] {
		background: var(--green);
		border-color: var(--green);
		color: #fff;
	}
	@media (max-width: 520px) {
		.post-card img {
			width: 80px;
			height: 80px;
		}
	}
</style>
