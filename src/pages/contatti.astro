---
import {
	CONTACT_EMAIL,
	FACEBOOK_URL,
	GOOGLE_LISTING_URL,
	INSTAGRAM_HANDLE,
	INSTAGRAM_URL,
	MAP_EMBED_URL,
	SITE_TITLE,
} from '../consts';
import Layout from '../layouts/Layout.astro';

const description = 'Come contattare AGESCI Trecastagni 1: email, mappa e profili social.';
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ContactPage',
	name: 'Contatti',
	url: new URL('/contatti/', Astro.site).href,
	about: { '@type': 'Organization', name: SITE_TITLE, email: CONTACT_EMAIL },
};
---

<Layout title="Contatti" description={description} jsonLd={jsonLd}>
	<h1>Contatti</h1>
	<div class="prose">
		<p>
			Per informazioni scrivi a <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
		</p>
		<p>Per chiedere l’ingresso nel gruppo vai alla pagina <a href="/iscrizione/">Iscrizione</a>.</p>

		<h2>Dove siamo</h2>
		<iframe
			class="map"
			title="Mappa: AGESCI Trecastagni 1"
			src={MAP_EMBED_URL}
			loading="lazy"
			referrerpolicy="no-referrer-when-downgrade"
			allowfullscreen></iframe>
		<p>
			<a href={GOOGLE_LISTING_URL} target="_blank" rel="noopener noreferrer"
				>Vedi la scheda su Google</a
			>
		</p>

		<h2>Social</h2>
		<p>
			<a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer"
				>Instagram {INSTAGRAM_HANDLE}</a
			>
			·
			<a href={FACEBOOK_URL} target="_blank" rel="noopener noreferrer">Facebook</a>
		</p>
	</div>
</Layout>

<style>
	.map {
		display: block;
		width: 100%;
		height: 400px;
		border-radius: 6px;
	}
</style>
